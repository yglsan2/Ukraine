{
  "name": "lumieres-ukraine",
  "version": "1.0.0",
  "description": "Application de partage de livres pour promouvoir la culture ukrainienne",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run clean:ports && vite",
    "dev:clean": "npm run clean:all && npm run dev",
    "build": "vite build",
    "preview": "npm run clean:ports && vite preview",
    "preview:clean": "npm run clean:all && npm run preview",
    "serve": "npm run clean:ports && npm run build && cd dist && python3 -m http.server 8080",
    "serve:clean": "npm run clean:all && npm run serve",
    "clean:ports": "pkill -f 'vite\\|http.server\\|python.*http.server' || true",
    "clean:all": "npm run clean:ports && rm -rf dist node_modules/.vite && npm install",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "cypress run",
    "test:e2e:dev": "cypress open",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never"
  },
  "keywords": [
    "ukraine",
    "books",
    "sharing",
    "culture",
    "vue",
    "pwa",
    "electron"
  ],
  "author": "Lumières d'Ukraine",
  "license": "MIT",
  "devDependencies": {
    "@cypress/code-coverage": "^0.3.0",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^8.2.2",
    "cypress": "^14.5.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.49.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "~5.3.0",
    "vite": "^7.0.4",
    "vite-plugin-vue-devtools": "^7.0.7",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.2",
    "leaflet": "^1.9.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "build": {
    "appId": "com.lumieresukraine.app",
    "productName": "Lumières d'Ukraine",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "public/icons/icon-512x512.icns"
    },
    "win": {
      "icon": "public/icons/icon-512x512.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "public/icons/icon-512x512.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
